        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="In this experiment,&amp;#10;An image will appear with 6 letters: three above and three below the image.&amp;#10;&amp;#10;One of these letters will be either X or N. The remaining letters will be O&amp;#10;&amp;#10;Ignore the image and identifythe target letter as quickly and accurately as possible. &amp;#10;&amp;#10;Press X if the target is X.&amp;#10;Press N if the target is N.&amp;#10;&amp;#10;press SPACE to continue&amp;#10;" valType="str" updates="constant" name="text"/>
        <Param val="from exp settings" valType="str" updates="None" name="units"/>
        <Param val="" valType="code" updates="None" name="validator"/>
        <Param val="" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
